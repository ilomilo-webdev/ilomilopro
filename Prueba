        <button onclick="closeModal('modal-reset')" class="yk-btn yk-btn-ghost flex-1">Cancelar</button>
        <button onclick="handleReset()" class="yk-btn yk-btn-red flex-1"><i class="fas fa-trash-can"></i> Eliminar todo</button>
