<script>
// ==========================================
// ESTADO
// ==========================================
let state = {
  currentAccount: null,
  adminTab: 'overview'
};

// ==========================================
// CAPA DE DATOS (localStorage)
// ==========================================
function getAccounts() {
  return JSON.parse(localStorage.getItem('yg_accounts') || '{}');
}
function saveAccounts(data) {
  localStorage.setItem('yg_accounts', JSON.stringify(data));
}
function getTransactions() {
  return JSON.parse(localStorage.getItem('yg_transactions') || '[]');
}
function saveTransactions(data) {
  localStorage.setItem('yg_transactions', JSON.stringify(data));
}

// Inicializar cuenta admin si no existe
function initData() {
  const accts = getAccounts();
  if (!accts['0001']) {
    accts['0001'] = {
      name: 'Administracion',
      password: 'admin123',
      balance: 50000000,
      createdAt: new Date().toISOString()
    };
    saveAccounts(accts);
  }
}

// Siguiente numero de cuenta disponible
function nextAccountNum() {
  const accts = getAccounts();
  let n = 2;
  while (accts[String(n).padStart(4, '0')]) n++;
  if (n > 9999) return null;
  return String(n).padStart(4, '0');
}

// ==========================================
// UTILIDADES
// ==========================================
function formatYen(amount) {
  return '¥' + Number(amount).toLocaleString('ja-JP');
}
function formatDate(iso) {
  const d = new Date(iso);
  const pad = v => String(v).padStart(2, '0');
  return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
}
function parseAmount(str) {
  // Limpiar y parsear: acepta numeros con o sin separadores
  const cleaned = String(str).replace(/[^\d]/g, '');
  const num = parseInt(cleaned, 10);
  return isNaN(num) || num <= 0 ? null : num;
}
function setAmount(inputId, amount) {
  document.getElementById(inputId).value = amount;
}

function txTypeInfo(type) {
  switch(type) {
    case 'deposit': return { label: 'Deposito', icon: 'fa-arrow-down', bg: 'rgba(34,197,94,0.1)', color: '#4ade80', border: 'rgba(34,197,94,0.2)' };
    case 'transfer_out': return { label: 'Enviado', icon: 'fa-arrow-right', bg: 'rgba(96,165,250,0.1)', color: '#60a5fa', border: 'rgba(96,165,250,0.2)' };
    case 'transfer_in': return { label: 'Recibido', icon: 'fa-arrow-left', bg: 'rgba(96,165,250,0.1)', color: '#60a5fa', border: 'rgba(96,165,250,0.2)' };
    case 'purchase': return { label: 'Compra', icon: 'fa-shopping-bag', bg: 'rgba(251,146,60,0.1)', color: '#fb923c', border: 'rgba(251,146,60,0.2)' };
    default: return { label: type, icon: 'fa-circle', bg: 'rgba(138,126,114,0.1)', color: '#8a7e72', border: 'rgba(138,126,114,0.2)' };
  }
}

// ==========================================
// TOASTS
// ==========================================
function toast(message, type = 'info') {
  const container = document.getElementById('toasts');
  const el = document.createElement('div');
  el.className = `toast toast-${type}`;
  const icons = { success: 'fa-check-circle', error: 'fa-circle-exclamation', info: 'fa-circle-info' };
  el.innerHTML = `<i class="fas ${icons[type] || icons.info}"></i><span>${message}</span>`;
  container.appendChild(el);
  setTimeout(() => {
    el.style.animation = 'toastOut 0.3s ease-in forwards';
    setTimeout(() => el.remove(), 300);
  }, 3500);
}

// ==========================================
// VISTAS Y MODALES
// ==========================================
function showView(id) {
  document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
  const target = document.getElementById(id);
  if (target) {
    target.classList.remove('hidden');
    target.classList.remove('view-enter');
    void target.offsetWidth; // forzar reflow
    target.classList.add('view-enter');
  }
}
function openModal(id) {
  document.getElementById(id).classList.remove('hidden');
  // Limpiar formularios al abrir
  const formFields = document.getElementById(id).querySelectorAll('input');
  formFields.forEach(f => { if(f.type !== 'hidden') f.value = ''; });
}
function closeModal(id) {
  document.getElementById(id).classList.add('hidden');
}

// ==========================================
// AUTENTICACION
// ==========================================
function handleLogin() {
  const num = String(document.getElementById('login-account').value).trim().padStart(4, '0');
  const pw = document.getElementById('login-password').value;
  const accts = getAccounts();

  if (!accts[num]) { toast('Cuenta no encontrada', 'error'); return; }
  if (accts[num].password !== pw) { toast('Contrasena incorrecta', 'error'); return; }

  state.currentAccount = num;
  sessionStorage.setItem('yg_session', num);

  if (num === '0001') {
    showView('view-admin');
    renderAdminDashboard();
    // Aviso si sigue con contraseña por defecto
    if (accts[num].password === 'admin123') {
      setTimeout(() => toast('Cambia la contrasena por defecto (admin123)', 'info'), 500);
    }
  } else {
    showView('view-player');
    renderPlayerDashboard();
  }
  toast(`Bienvenido, ${accts[num].name}`, 'success');
}

function handleRegister() {
  const name = document.getElementById('reg-name').value.trim();
  const pw = document.getElementById('reg-password').value;
  const pw2 = document.getElementById('reg-password2').value;

  if (!name || name.length < 2) { toast('El nombre debe tener al menos 2 caracteres', 'error'); return; }
  if (pw.length < 4) { toast('La contrasena debe tener al menos 4 caracteres', 'error'); return; }
  if (pw !== pw2) { toast('Las contrasenas no coinciden', 'error'); return; }

  const num = nextAccountNum();
  if (!num) { toast('No hay mas cuentas disponibles', 'error'); return; }

  const accts = getAccounts();
  accts[num] = { name, password: pw, balance: 0, createdAt: new Date().toISOString() };
  saveAccounts(accts);

  document.getElementById('new-account-number').textContent = num;
  showView('view-reg-success');
  toast('Cuenta creada con exito', 'success');
}

function handleLogout() {
  state.currentAccount = null;
  sessionStorage.removeItem('yg_session');
  showView('view-login');
  // Limpiar campos de login
  document.getElementById('login-account').value = '';
  document.getElementById('login-password').value = '';
}

function handleChangePw() {
  const oldPw = document.getElementById('pw-old').value;
  const newPw = document.getElementById('pw-new').value;
  const newPw2 = document.getElementById('pw-new2').value;
  const accts = getAccounts();
  const acct = accts[state.currentAccount];

  if (!acct) { toast('Sesion invalida', 'error'); return; }
  if (oldPw !== acct.password) { toast('Contrasena actual incorrecta', 'error'); return; }
  if (newPw.length < 4) { toast('La nueva contrasena debe tener al menos 4 caracteres', 'error'); return; }
  if (newPw !== newPw2) { toast('Las nuevas contrasenas no coinciden', 'error'); return; }

  acct.password = newPw;
  saveAccounts(accts);
  closeModal('modal-changepw');
  toast('Contrasena actualizada', 'success');
}

// Enter para login
document.getElementById('login-password').addEventListener('keydown', e => { if(e.key==='Enter') handleLogin(); });
document.getElementById('login-account').addEventListener('keydown', e => { if(e.key==='Enter') document.getElementById('login-password').focus(); });
document.getElementById('reg-password2').addEventListener('keydown', e => { if(e.key==='Enter') handleRegister(); });

// ==========================================
// TRANSACCIONES
// ==========================================
function addTransaction(type, from, to, amount, description) {
  const tx = {
    id: Date.now().toString(36) + Math.random().toString(36).substr(2,4),
    type, from, to, amount, description,
    timestamp: new Date().toISOString()
  };
  const txns = getTransactions();
  txns.unshift(tx);
  saveTransactions(txns);
  return tx;
}

function handleDeposit() {
  const target = document.getElementById('deposit-target').value;
  const amount = parseAmount(document.getElementById('deposit-amount').value);
  const desc = document.getElementById('deposit-desc').value.trim() || 'Deposito del banco';

  if (!target) { toast('Selecciona una cuenta', 'error'); return; }
  if (!amount) { toast('Cantidad invalida', 'error'); return; }

  const accts = getAccounts();
  if (!accts[target]) { toast('Cuenta destino no existe', 'error'); return; }

  accts[target].balance += amount;
  saveAccounts(accts);
  addTransaction('deposit', 'BANCO', target, amount, desc);

  document.getElementById('deposit-amount').value = '';
  document.getElementById('deposit-desc').value = '';
  toast(`${formatYen(amount)} depositados en ${target}`, 'success');
  renderAdminDashboard();
}

function openTransferModal() {
  openModal('modal-transfer');
}

function handleTransfer() {
  const target = String(document.getElementById('transfer-target').value).trim().padStart(4, '0');
  const amount = parseAmount(document.getElementById('transfer-amount').value);
  const desc = document.getElementById('transfer-desc').value.trim() || 'Transferencia';
  const accts = getAccounts();
  const sender = state.currentAccount;

  if (target === sender) { toast('No puedes transferirte a ti mismo', 'error'); return; }
  if (!accts[target]) { toast('La cuenta destino no existe', 'error'); return; }
  if (!amount) { toast('Cantidad invalida', 'error'); return; }
  if (accts[sender].balance < amount) { toast('Saldo insuficiente', 'error'); return; }

  accts[sender].balance -= amount;
  accts[target].balance += amount;
  saveAccounts(accts);

  // Transaccion de salida para el remitente
  addTransaction('transfer_out', sender, target, amount, desc);
  // Transaccion de entrada para el destinatario
  addTransaction('transfer_in', sender, target, amount, desc);

  closeModal('modal-transfer');
  toast(`${formatYen(amount)} enviados a ${target}`, 'success');
  renderPlayerDashboard();
}

function openPurchaseModal() {
  openModal('modal-purchase');
}

function handlePurchase() {
  const amount = parseAmount(document.getElementById('purchase-amount').value);
  const desc = document.getElementById('purchase-desc').value.trim() || 'Compra';
  const accts = getAccounts();
  const acct = state.currentAccount;

  if (!amount) { toast('Cantidad invalida', 'error'); return; }
  if (accts[acct].balance < amount) { toast('Saldo insuficiente', 'error'); return; }

  accts[acct].balance -= amount;
  saveAccounts(accts);
  addTransaction('purchase', acct, 'SISTEMA', amount, desc);

  closeModal('modal-purchase');
  toast(`Compra de ${formatYen(amount)} registrada`, 'success');
  renderPlayerDashboard();
}

// ==========================================
// RENDERIZADO: JUGADOR
// ==========================================
function renderPlayerDashboard() {
  const accts = getAccounts();
  const acct = accts[state.currentAccount];
  if (!acct) { handleLogout(); return; }

  document.getElementById('player-acct-num').textContent = state.currentAccount;
  document.getElementById('player-name-header').textContent = acct.name;
  document.getElementById('player-name-display').textContent = acct.name;
  document.getElementById('player-balance').textContent = formatYen(acct.balance);

  // Historial de transacciones del jugador
  const allTx = getTransactions();
  const myTx = allTx.filter(t => t.from === state.currentAccount || t.to === state.currentAccount);

  const container = document.getElementById('player-tx-history');
  if (myTx.length === 0) {
    container.innerHTML = '<p class="text-yk-dim text-sm text-center py-8">Sin movimientos todavia</p>';
    return;
  }

  let html = '<table class="yk-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Detalle</th><th>Monto</th></tr></thead><tbody>';
  myTx.slice(0, 50).forEach(tx => {
    const info = txTypeInfo(tx.type);
    const isPositive = tx.type === 'deposit' || tx.type === 'transfer_in';
    const sign = isPositive ? '+' : '-';
    const colorClass = isPositive ? 'text-green-400' : 'text-red-400';
    let detail = '';
    if (tx.type === 'deposit') detail = `Del Banco`;
    else if (tx.type === 'transfer_out') detail = `A ${tx.to}`;
    else if (tx.type === 'transfer_in') detail = `De ${tx.from}`;
    else if (tx.type === 'purchase') detail = tx.description;

    html += `<tr>
      <td class="text-yk-dim text-xs whitespace-nowrap">${formatDate(tx.timestamp)}</td>
      <td><span class="tx-badge" style="background:${info.bg};color:${info.color};border:1px solid ${info.border}"><i class="fas ${info.icon}" style="font-size:10px"></i> ${info.label}</span></td>
      <td class="text-sm">${detail}</td>
      <td class="${colorClass} font-bold text-sm whitespace-nowrap">${sign}${formatYen(tx.amount)}</td>
    </tr>`;
  });
  html += '</tbody></table>';
  container.innerHTML = html;
}

// ==========================================
// RENDERIZADO: ADMIN
// ==========================================
function switchAdminTab(tab) {
  state.adminTab = tab;
  document.querySelectorAll('.admin-tab').forEach(t => {
    t.classList.toggle('tab-active', t.dataset.tab === tab);
  });
  document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.add('hidden'));
  document.getElementById('tab-' + tab).classList.remove('hidden');
  renderAdminDashboard();
}

function renderAdminDashboard() {
  const accts = getAccounts();
  const txns = getTransactions();
  const tab = state.adminTab;

  // --- Panel General ---
  if (tab === 'overview') {
    const acctList = Object.entries(accts);
    const playerAccts = acctList.filter(([n]) => n !== '0001');
    const totalInCirculation = playerAccts.reduce((s, [,a]) => s + a.balance, 0);
    const adminBalance = accts['0001'] ? accts['0001'].balance : 0;

    document.getElementById('admin-stats').innerHTML = `
      <div class="yk-card text-center">
        <p class="text-yk-dim text-xs uppercase tracking-wider mb-1">Fondo del Banco</p>
        <p class="text-yk-gold font-bold text-xl">${formatYen(adminBalance)}</p>
      </div>
      <div class="yk-card text-center">
        <p class="text-yk-dim text-xs uppercase tracking-wider mb-1">En circulacion</p>
        <p class="text-green-400 font-bold text-xl">${formatYen(totalInCirculation)}</p>
      </div>
      <div class="yk-card text-center">
        <p class="text-yk-dim text-xs uppercase tracking-wider mb-1">Cuentas activas</p>
        <p class="text-yk-text font-bold text-xl">${playerAccts.length}</p>
      </div>
      <div class="yk-card text-center">
        <p class="text-yk-dim text-xs uppercase tracking-wider mb-1">Transacciones</p>
        <p class="text-yk-text font-bold text-xl">${txns.length}</p>
      </div>
    `;

    // Ultimos movimientos
    renderTxTable('admin-recent-tx', txns.slice(0, 15), true);
  }

  // --- Cuentas ---
  if (tab === 'accounts') {
    const acctList = Object.entries(accts).sort((a,b) => a[0].localeCompare(b[0]));
    let html = '<table class="yk-table"><thead><tr><th>Cuenta</th><th>Nombre</th><th>Saldo</th><th>Mov.</th><th>Acciones</th></tr></thead><tbody>';
    acctList.forEach(([num, acct]) => {
      const txCount = txns.filter(t => t.from === num || t.to === num).length;
      const isAdmin = num === '0001';
      html += `<tr>
        <td class="font-bold font-cinzel ${isAdmin ? 'text-yk-red' : 'text-yk-gold'}">${num}</td>
        <td>${acct.name}</td>
        <td class="font-bold">${formatYen(acct.balance)}</td>
        <td class="text-yk-dim">${txCount}</td>
        <td class="flex gap-2">
          <button onclick="viewAcctDetail('${num}')" class="yk-btn yk-btn-ghost yk-btn-sm"><i class="fas fa-eye"></i></button>
          ${!isAdmin ? `<button onclick="prefillDeposit('${num}')" class="yk-btn yk-btn-ghost yk-btn-sm" title="Depositar"><i class="fas fa-coins"></i></button>` : ''}
        </td>
      </tr>`;
    });
    html += '</tbody></table>';
    document.getElementById('admin-accounts-table').innerHTML = html;
  }

  // --- Depositar ---
  if (tab === 'deposit') {
    // Llenar dropdown
    const select = document.getElementById('deposit-target');
    const currentVal = select.value;
    const acctList = Object.entries(accts).filter(([n]) => n !== '0001').sort((a,b) => a[0].localeCompare(b[0]));
    select.innerHTML = '<option value="">-- Seleccionar cuenta --</option>' +
      acctList.map(([num, acct]) => `<option value="${num}" ${num===currentVal?'selected':''}>${num} — ${acct.name}</option>`).join('');

    // Depositos recientes
    const deposits = txns.filter(t => t.type === 'deposit').slice(0, 10);
    renderTxTable('admin-deposits-recent', deposits, false);
  }

  // --- Transacciones ---
  if (tab === 'transactions') {
    renderAdminTransactions();
  }
}

function renderAdminTransactions() {
  let txns = getTransactions();
  const filterAcct = String(document.getElementById('tx-filter-account').value).trim().padStart(4, '0');
  const filterType = document.getElementById('tx-filter-type').value;

  if (filterAcct && filterAcct !== '0000') {
    txns = txns.filter(t => t.from === filterAcct || t.to === filterAcct);
  }
  if (filterType === 'transfer') {
    txns = txns.filter(t => t.type === 'transfer_out' || t.type === 'transfer_in');
  } else if (filterType) {
    txns = txns.filter(t => t.type === filterType);
  }

  renderTxTable('admin-all-tx', txns.slice(0, 100), true);
}

function renderTxTable(containerId, txns, showAccounts) {
  const container = document.getElementById(containerId);
  if (txns.length === 0) {
    container.innerHTML = '<p class="text-yk-dim text-sm text-center py-6">Sin transacciones</p>';
    return;
  }
  let html = '<table class="yk-table"><thead><tr><th>Fecha</th>';
  if (showAccounts) html += '<th>De</th><th>A</th>';
  html += '<th>Tipo</th><th>Concepto</th><th>Monto</th></tr></thead><tbody>';
  txns.forEach(tx => {
    const info = txTypeInfo(tx.type);
    const isPositive = tx.type === 'deposit' || tx.type === 'transfer_in';
    const colorClass = isPositive ? 'text-green-400' : 'text-red-400';
    const sign = isPositive ? '+' : '-';
    html += `<tr>
      <td class="text-yk-dim text-xs whitespace-nowrap">${formatDate(tx.timestamp)}</td>
      ${showAccounts ? `<td class="text-sm font-mono ${tx.from==='BANCO'?'text-yk-gold':tx.from==='SISTEMA'?'text-yk-dim':''}">${tx.from}</td>
      <td class="text-sm font-mono ${tx.to==='SISTEMA'?'text-yk-dim':tx.to==='BANCO'?'text-yk-gold':''}">${tx.to}</td>` : ''}
      <td><span class="tx-badge" style="background:${info.bg};color:${info.color};border:1px solid ${info.border}"><i class="fas ${info.icon}" style="font-size:10px"></i> ${info.label}</span></td>
      <td class="text-sm text-yk-muted max-w-[200px] truncate">${tx.description || '—'}</td>
      <td class="${colorClass} font-bold text-sm whitespace-nowrap">${sign}${formatYen(tx.amount)}</td>
    </tr>`;
  });
  html += '</tbody></table>';
  container.innerHTML = html;
}

// Ver detalle de cuenta (modal)
function viewAcctDetail(num) {
  const accts = getAccounts();
  const acct = accts[num];
  if (!acct) return;

  const txns = getTransactions().filter(t => t.from === num || t.to === num);
  const isAdmin = num === '0001';

  let html = `
    <div class="flex items-center gap-4 mb-6 pb-4 border-b border-yk-border">
      <div class="w-14 h-14 rounded-full ${isAdmin ? 'bg-yk-red/15' : 'bg-yk-gold/15'} flex items-center justify-center">
        <span class="font-cinzel text-xl font-black ${isAdmin ? 'text-yk-red' : 'text-yk-gold'}">${num}</span>
      </div>
      <div>
        <p class="font-bold text-lg">${acct.name}</p>
        <p class="text-yk-muted text-sm">${isAdmin ? 'Cuenta de administracion' : 'Cuenta de jugador'}</p>
      </div>
    </div>
    <div class="mb-4">
      <p class="text-yk-dim text-xs uppercase tracking-wider">Saldo actual</p>
      <p class="balance-gold text-2xl font-cinzel">${formatYen(acct.balance)}</p>
    </div>
    <div class="mb-4 text-xs text-yk-dim">
      <p>Creada: ${formatDate(acct.createdAt)}</p>
      <p>Total movimientos: ${txns.length}</p>
    </div>
    <div class="mt-4">
      <p class="text-xs text-yk-muted font-semibold uppercase tracking-wider mb-3">Historial</p>
      <div class="max-h-60 overflow-y-auto">`;

  if (txns.length === 0) {
    html += '<p class="text-yk-dim text-sm text-center py-4">Sin movimientos</p>';
  } else {
    html += '<table class="yk-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Detalle</th><th>Monto</th></tr></thead><tbody>';
    txns.slice(0, 30).forEach(tx => {
      const info = txTypeInfo(tx.type);
      const isPositive = tx.type === 'deposit' || tx.type === 'transfer_in';
      const sign = isPositive ? '+' : '-';
      const colorClass = isPositive ? 'text-green-400' : 'text-red-400';
      let detail = '';
      if (tx.type === 'deposit') detail = 'Del Banco';
      else if (tx.type === 'transfer_out') detail = `A ${tx.to}`;
      else if (tx.type === 'transfer_in') detail = `De ${tx.from}`;
      else if (tx.type === 'purchase') detail = tx.description;

      html += `<tr>
        <td class="text-yk-dim text-xs whitespace-nowrap">${formatDate(tx.timestamp)}</td>
        <td><span class="tx-badge" style="background:${info.bg};color:${info.color};border:1px solid ${info.border}"><i class="fas ${info.icon}" style="font-size:9px"></i> ${info.label}</span></td>
        <td class="text-xs">${detail}</td>
        <td class="${colorClass} font-bold text-xs whitespace-nowrap">${sign}${formatYen(tx.amount)}</td>
      </tr>`;
    });
    html += '</tbody></table>';
  }

  html += '</div></div>';
  document.getElementById('acct-detail-content').innerHTML = html;
  openModal('modal-acct-detail');
}

// Prefill deposit desde tabla de cuentas
function prefillDeposit(num) {
  switchAdminTab('deposit');
  setTimeout(() => {
    document.getElementById('deposit-target').value = num;
    document.getElementById('deposit-amount').focus();
  }, 50);
}

// Reset total
function confirmReset() {
  openModal('modal-reset');
}
function handleReset() {
  const adminAcct = getAccounts()['0001'];
  saveAccounts({ '0001': adminAcct });
  saveTransactions([]);
  closeModal('modal-reset');
  toast('Todos los datos han sido eliminados', 'success');
  renderAdminDashboard();
}

// ==========================================
// INICIALIZACION
// ==========================================
function init() {
  initData();

  // Verificar sesion existente
  const session = sessionStorage.getItem('yg_session');
  if (session) {
    const accts = getAccounts();
    if (accts[session]) {
      state.currentAccount = session;
      if (session === '0001') {
        showView('view-admin');
        renderAdminDashboard();
      } else {
        showView('view-player');
        renderPlayerDashboard();
      }
      return;
    }
  }
  showView('view-login');
}

init();
</script>
